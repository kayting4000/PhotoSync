# PostgreSQL Database Connection (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/photosync

# JWT Secret for token generation (Required)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Roboflow API Configuration (Required for scanner)
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_WORKSPACE=your-workspace-name
ROBOFLOW_WORKFLOW_ID=your-workflow-id

# Email Service Configuration (Optional - for grade distribution)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
